# Reactor API key (rk_...). Server-side only: it is exchanged for short-lived,
# session-scoped JWTs and never reaches the browser.
REACTOR_API_KEY=

# World model to drive. Must be a key of the registry in @atlas/world.
# lingbot-world-2 (default) | lingbot
ATLAS_WORLD_MODEL=lingbot-world-2

# Directory holding the editorial archive (JSON articles + images).
# Relative paths resolve from the repository root.
ATLAS_CONTENT_DIR=content

# Optional side-channel ingest (POST an article, or a news URL). Off by default;
# the core archive pipeline never touches it.
ATLAS_INGEST_ENABLED=false
ATLAS_INGEST_TOKEN=
